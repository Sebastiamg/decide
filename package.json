{
  "name": "decide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DECIDE: motor de microdesafíos educativos de velocidad, precisión y observación.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:engine": "rolldown scripts/engine-check.ts --format esm --platform node -o node_modules/.tmp/engine-check.mjs && node node_modules/.tmp/engine-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.2"
  }
}
